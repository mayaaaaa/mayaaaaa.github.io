import turtle
import math

t = turtle.Turtle()
t.speed(0)
turtle.bgcolor("black")
t.color("red")
t.width(2)

# heart function
def heart(k):
    return 15 * math.sin(k)**3

def heart2(k):
    return 12 * math.cos(k) - 5 * math.cos(2*k) - 2 * math.cos(3*k) - math.cos(4*k)

# multiple layered heart
for j in range(25):
    t.penup()
    t.goto(0, 0)
    t.pendown()
    for i in range(360):
        x = heart(math.radians(i)) * (1 + j * 0.03)
        y = heart2(math.radians(i)) * (1 + j * 0.03)
        t.goto(x, y)

t.hideturtle()
turtle.done()
